{
  "name": "roundtable",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node init && concurrently -n \"api,web\" -c \"yellow.bold,cyan.bold\" --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "node init && docker compose up -d && concurrently -n \"api,web\" -c \"yellow.bold,cyan.bold\" --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "node init && npm run dev -w @roundtable/web",
    "dev:api": "node init && npm run start:dev -w @roundtable/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build:shared": "node init && npm run build -w @roundtable/shared",
    "build:api": "node init && npm run build -w @roundtable/api",
    "build:web": "node init && npm run build -w @roundtable/web",
    "build": "node init && npm run build:shared && npm run build:api && npm run build:web",
    "db:generate": "npx prisma generate --schema=services/api/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=services/api/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=services/api/prisma/schema.prisma",
    "db:seed": "npm run seed -w @roundtable/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
